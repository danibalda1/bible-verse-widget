<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📖 Idioma del widget"
            android:textColor="#1E3A8A"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Elige el idioma del versículo que verás en tu pantalla:"
            android:textColor="#5B7BB4"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <RadioGroup
            android:id="@+id/lang_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/lang_es"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🇪🇸  Español"
                android:textColor="#1E3A8A"
                android:textSize="18sp"
                android:paddingVertical="10dp" />

            <RadioButton
                android:id="@+id/lang_en"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🇬🇧  English"
                android:textColor="#1E3A8A"
                android:textSize="18sp"
                android:paddingVertical="10dp" />

            <RadioButton
                android:id="@+id/lang_pt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🇧🇷  Português"
                android:textColor="#1E3A8A"
                android:textSize="18sp"
                android:paddingVertical="10dp" />

            <RadioButton
                android:id="@+id/lang_fr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🇫🇷  Français"
                android:textColor="#1E3A8A"
                android:textSize="18sp"
                android:paddingVertical="10dp" />

            <RadioButton
                android:id="@+id/lang_it"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🇮🇹  Italiano"
                android:textColor="#1E3A8A"
                android:textSize="18sp"
                android:paddingVertical="10dp" />
        </RadioGroup>

        <Button
            android:id="@+id/save_lang_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Guardar idioma"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
